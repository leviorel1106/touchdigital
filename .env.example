# Server only: where every lead is stored. The form is live as soon as these two are set.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional mail notification on top of storage. Use an address on a verified Resend domain.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
# International digits only, e.g. 972 followed by the number without its leading 0.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Set the real HTTPS domain before publication.
NEXT_PUBLIC_SITE_URL=
# Keep false until real work, biography and contact details are ready.
NEXT_PUBLIC_SITE_READY=false
